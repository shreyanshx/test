{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "test",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  // Static frontend served from ./public via the Worker.
  // not_found_handling "single-page-application" makes unknown paths fall back to index.html.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "testpaper_db",
      // database_id is a PLACEHOLDER. Before your first real deploy, run:
      //   npx wrangler d1 create testpaper_db
      // then paste the returned "database_id" value below (replacing this placeholder).
      "database_id": "PLACEHOLDER-REPLACE-AFTER-wrangler-d1-create",
      "migrations_dir": "migrations"
    }
  ]
}
